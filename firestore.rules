rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workshops/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /bookings/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_uid;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
