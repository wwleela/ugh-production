        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16">
            <span class="text-ugh-teal font-bold uppercase tracking-widest text-xs font-display">Where We Teach</span>
            <h2 class="text-4xl md:text-5xl font-display font-bold mt-2">Our Public Venues</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 bg-white border border-border-gray">
