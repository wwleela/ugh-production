              <span class="inline-block px-3 py-1 bg-gray-100 text-charcoal text-[10px] font-bold uppercase tracking-widest rounded-full mb-4 border border-gray-200">Public Access</span>
              <h3 class="text-2xl font-display font-bold mb-1">Primo Skatepark</h3>
              <p class="text-ugh-orange text-xs font-bold uppercase tracking-widest mb-4 font-display">Hyderabad</p>
              <p class="text-gray-600 text-sm">Street plaza elements and mini ramps.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="py-24 px-6">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-display font-bold">FAQs</h2>
          </div>
          <div class="space-y-4">
            <details class="p-6 bg-white border border-border-gray cursor-pointer group">
              <summary class="font-display font-bold text-lg list-none flex justify-between items-center">What gear is mandatory? <span class="text-ugh-orange text-2xl group-open:rotate-45 transition-transform">+</span></summary>
              <p class="mt-4 text-gray-600 text-sm leading-relaxed">A certified helmet, wrist guards, elbow pads, and knee pads are non-negotiable for every class. No exceptions.</p>
            </details>
            <details class="p-6 bg-white border border-border-gray cursor-pointer group">
              <summary class="font-display font-bold text-lg list-none flex justify-between items-center">What is the age limit? <span class="text-ugh-orange text-2xl group-open:rotate-45 transition-transform">+</span></summary>
              <p class="mt-4 text-gray-600 text-sm leading-relaxed">We teach Junior (5-12 yrs), Senior (13-17 yrs), and Adult gliders. Everyone is welcome to learn.</p>
            </details>
            <details class="p-6 bg-white border border-border-gray cursor-pointer group">
              <summary class="font-display font-bold text-lg list-none flex justify-between items-center">What happens if it rains? <span class="text-ugh-orange text-2xl group-open:rotate-45 transition-transform">+</span></summary>
              <p class="mt-4 text-gray-600 text-sm leading-relaxed">In case of rain, sessions will be rescheduled to a make-up day, ensuring you don't miss out on your training.</p>
            </details>
            <details class="p-6 bg-white border border-border-gray cursor-pointer group">
              <summary class="font-display font-bold text-lg list-none flex justify-between items-center">What should I bring to my first session? <span class="text-ugh-orange text-2xl group-open:rotate-45 transition-transform">+</span></summary>
              <p class="mt-4 text-gray-600 text-sm leading-relaxed">Please wear comfortable athletic clothing and closed-toe shoes. All necessary protective gear is provided, or you must bring your own per our mandatory safety policy.</p>
            </details>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-charcoal text-white py-12 px-6 border-t border-gray-800 text-center md:text-left">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
        <div>
          <h2 class="text-2xl font-display font-bold tracking-tighter mb-2">UGH<span class="text-ugh-orange">.</span></h2>
          <p class="text-gray-400 text-sm mb-1">Urban Gliding Hyderabad</p>
          <p class="text-gray-500 text-xs">MSME Registered: UDYAM-TS-09-0222985</p>
        </div>
        <div class="text-sm text-gray-400">
          <p class="mb-2">Call / WhatsApp: <a href="https://wa.me/916304895686" class="text-white hover:text-ugh-teal transition-colors font-bold">+916304895686</a></p>
          <p>&copy; 2026 Urban Gliding Hyderabad. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile Sticky Nav -->
    <div class="md:hidden fixed bottom-0 left-0 w-full bg-white/95 backdrop-blur-xl border-t border-border-gray p-4 flex gap-3 z-50">
      <a href="#programs" class="flex-1 text-center py-3.5 bg-gray-100 rounded font-display font-bold text-xs uppercase tracking-widest border border-border-gray text-charcoal">View Pricing</a>
      <button onclick="window.open('https://wa.me/916304895686', '_blank')" class="flex-1 text-center py-3.5 bg-ugh-teal text-white rounded font-display font-bold text-xs uppercase tracking-widest shadow-lg">WhatsApp</button>
    </div>

    <!-- Initialization Scripts -->
    <script>
      // Tab interaction
      const tabs = document.querySelectorAll('.tab-btn');
      const contents = document.querySelectorAll('.tab-content');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => { t.classList.remove('active'); t.classList.add('text-gray-500'); });
          contents.forEach(c => c.classList.remove('active'));
          tab.classList.add('active');
          tab.classList.remove('text-gray-500');
          document.getElementById(tab.dataset.target).classList.add('active');
        });
      });

      // Pricing Data & Rendering
      const programs = [
        { name: "Drop-in Session", price: "599", period: "session", desc: "Single coached session, no commitment.", features: ["Introduction to fundamentals", "Ages 5+ welcome"], badge: null },
        { name: "Monthly Academy", price: "5,999", period: "month", desc: "8 coached classes + unlimited monthly access to skate parks.", features: ["8 coached classes", "Unlimited park access", "Personal progression roadmap"], badge: "Featured" },
        { name: "Apartment/Society — Standard", price: "4,999", period: "month", desc: "8 classes per month, at your society.", features: ["8 on-site society classes", "Group learning dynamics", "Convenient doorstep coaching"], badge: null },
        { name: "Apartment/Society — Plus", price: "6,999", period: "month", desc: "8 classes + 3 skate park sessions per month.", features: ["8 on-site society classes", "3 skate park sessions", "Best of both worlds"], badge: "Comprehensive" },
        { name: "UGH VIP Skate Plan", price: "26,000 (Month 1) / 20,000 (Renewal)", period: "flagship", desc: "Month 1: 10 classes + 3 park sessions. Renewal: recurring monthly batch. Includes doorstep mobile skatepark, VIP kit, and a personalized journey video.", features: ["Doorstep mobile skatepark van", "Curated board + full armor kit", "Personalized video vlog"], badge: "VIP" }
      ];

      const grid = document.getElementById('pricing-grid');
      programs.forEach(p => {
        const msg = encodeURIComponent(`Hi Coach Leela, I want to enroll in ${p.name}. I'll send payment confirmation shortly.`);
        const isFeatured = p.badge === 'Featured';
        const isVIP = p.badge === 'VIP';
        
        let cardClass = 'bg-[#2A2A2A] text-white border border-gray-700';
        let btnClass = 'border border-gray-600 hover:bg-gray-700 text-white';
        let badgeClass = 'bg-gray-600 text-white';
        let checkClass = 'text-ugh-orange';
        
        if (isFeatured) {
          cardClass = 'bg-ugh-teal text-white border-none shadow-[8px_8px_0px_#00555d] scale-105';
          btnClass = 'bg-charcoal text-white border-none hover:bg-gray-800';
          badgeClass = 'bg-charcoal text-white';
          checkClass = 'text-white';
        } else if (isVIP) {
          cardClass = 'bg-gradient-to-br from-[#2a2410] to-[#1a170a] text-white border-2 border-ugh-mustard shadow-[0_0_30px_rgba(240,192,90,0.15)] lg:col-span-4 md:col-span-2 mx-auto w-full max-w-3xl scale-105 mt-8';
          btnClass = 'bg-ugh-mustard text-charcoal border-none hover:bg-[#d8a846] font-black shadow-md';
          badgeClass = 'bg-ugh-mustard text-charcoal';
          checkClass = 'text-ugh-mustard';
        }
        
        grid.innerHTML += `
          <div class="p-8 ${cardClass} relative flex flex-col">
            ${p.badge ? `<span class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 ${badgeClass} text-[10px] font-bold uppercase tracking-widest font-display">${p.badge}</span>` : ''}
            <h3 class="text-2xl font-display font-bold mb-2">${p.name}</h3>
            <div class="mb-4">
              <span class="text-4xl font-display font-bold">${p.price.includes('Month') ? `₹${p.price}` : `₹${p.price}`}</span>
              ${p.period !== 'flagship' ? `<span class="text-sm opacity-70">/${p.period}</span>` : ''}
            </div>
            <p class="text-sm opacity-80 mb-8 min-h-[40px] leading-relaxed">${p.desc}</p>
            <ul class="space-y-3 mb-8 flex-1">
              ${p.features.map(f => `<li class="flex items-start gap-3 text-sm"><span class="${checkClass} text-lg leading-none">✓</span> <span class="opacity-80">${f}</span></li>`).join('')}
            </ul>
            <button onclick="window.open('https://wa.me/916304895686?text=${msg}', '_blank')" class="w-full py-4 font-display font-bold uppercase tracking-widest text-xs transition-colors ${btnClass}">
              Book on WhatsApp
            </button>
          </div>
        `;
      });
    </script>
  </body>
</html>
