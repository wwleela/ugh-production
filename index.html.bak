<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Urban Gliding Hyderabad (UGH) - Hyderabad's premier doorstep skating coach. Professional skateboarding, inline skating, and BMX workshops, plus vibrant community events across residential complexes." />
    <link rel="canonical" href="https://ugh.co.in/" />
    <title>UGH - Urban Gliding Hyderabad</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              charcoal: '#1A1A1A',
              'ugh-teal': '#008491',
              'ugh-orange': '#C86733',
              'ugh-mustard': '#F0C05A',
              'border-gray': '#E0E0E0',
              'off-white': '#FDFDFD'
            },
            fontFamily: {
              display: ['Oswald', 'sans-serif'],
              body: ['Inter', 'sans-serif']
            }
          }
        }
      }
    </script>
    
    <style>
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', sans-serif; }
      h1, h2, h3, h4, h5, h6, .font-display { font-family: 'Oswald', sans-serif; text-transform: uppercase; }
      
      .tab-content { display: none; }
      .tab-content.active { display: grid; animation: fadeIn 0.4s ease-out forwards; }
      .tab-btn.active { border-bottom-color: #008491; color: #008491; }
      
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      .hero-bg {
        background-color: #1A1A1A;
        background-image: radial-gradient(circle at center, #2A2A2A 0%, #1A1A1A 100%);
      }
    </style>
    
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "SportsActivityLocation",
          "name": "Urban Gliding Hyderabad (UGH)",
          "description": "Hyderabad's premier doorstep skating coach. Professional skateboarding, inline skating, and BMX workshops.",
          "url": "https://ugh.co.in/",
          "telephone": "+916304895686",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hyderabad",
            "addressRegion": "Telangana",
            "addressCountry": "IN"
          },
          "identifier": {
            "@type": "PropertyValue",
            "name": "MSME Udyam Registration",
            "value": "UDYAM-TS-09-0222985"
          },
          "areaServed": [
            "Gachibowli",
            "Kokapet",
            "Financial District",
            "Narsingi",
            "Tellapur",
            "Peerancheru",
            "Kondapur",
            "Nallagandla",
            "Madhapur"
          ]
        },
        {
          "@type": "Event",
          "name": "Sunday Skateboarding Workshop",
          "startDate": "2026-08-30T07:00:00+05:30",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "eventStatus": "https://schema.org/EventScheduled",
          "location": {
            "@type": "Place",
            "name": "Workshop Venue",
            "address": "[VENUE ADDRESS — CONFIRM]"
          },
          "description": "Weekly recurring skateboarding workshop for all skill levels."
        },
        {
          "@type": "Event",
          "name": "Fam Jam",
          "startDate": "2026-08-29T16:00:00+05:30",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "eventStatus": "https://schema.org/EventScheduled",
          "location": {
            "@type": "Place",
            "name": "Workshop Venue",
            "address": "[VENUE ADDRESS — CONFIRM]"
          },
          "description": "Monthly skateboarding competition, beginner workshop, and youth culture event."
        }
      ]
    }
    </script>
  </head>
  <body class="bg-off-white text-charcoal antialiased">
    
    <!-- Header -->
    <header class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-md border-b border-border-gray">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="#" class="text-3xl font-display font-bold tracking-tighter">UGH<span class="text-ugh-orange">.</span></a>
        <nav class="hidden md:flex gap-8 font-bold text-sm uppercase tracking-widest font-display">
          <a href="#community" class="hover:text-ugh-teal transition-colors">Impact</a>
          <a href="#events" class="hover:text-ugh-teal transition-colors">Events</a>
          <a href="#programs" class="hover:text-ugh-teal transition-colors">Pricing</a>
          <a href="#venues" class="hover:text-ugh-teal transition-colors">Venues</a>
        </nav>
        <button onclick="window.open('https://wa.me/916304895686', '_blank')" class="bg-ugh-teal text-white px-6 py-3 rounded font-display font-bold uppercase tracking-widest text-xs flex items-center gap-2 hover:bg-[#006a75] transition-colors">
          Chat on WhatsApp
        </button>
      </div>
    </header>

    <main class="pt-20">
      
      <!-- Hero -->
      <section class="hero-bg text-white py-32 px-6 text-center">
        <div class="max-w-5xl mx-auto">
          <span class="inline-block px-4 py-1.5 border border-ugh-teal text-ugh-teal text-xs font-bold uppercase tracking-widest rounded-full mb-8 font-display">
            Hyderabad's Skate Community
          </span>
          <h1 class="text-6xl md:text-8xl font-display font-bold mb-8 leading-tight tracking-tight">
            Learn <br>
            <span class="text-ugh-orange italic">Skateboarding, Inline Skating & BMX</span><br>
            in Hyderabad
          </h1>
          <p class="text-lg md:text-xl text-gray-400 mb-12 max-w-2xl mx-auto leading-relaxed">
            Professional coaching built on international action sports frameworks, administered by verified sports leaders.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <button onclick="window.open('https://wa.me/916304895686', '_blank')" class="bg-ugh-orange text-white px-10 py-5 rounded font-display font-bold uppercase tracking-widest text-sm hover:bg-[#b0572a] transition-colors">
              Book on WhatsApp
            </button>
            <a href="#programs" class="px-10 py-5 rounded border-2 border-gray-600 font-display font-bold uppercase tracking-widest text-sm hover:border-white transition-colors text-center">
              View Pricing
            </a>
          </div>
        </div>
      </section>

      <!-- Disciplines -->
      <section id="disciplines" class="py-24 px-6 border-b border-border-gray">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16">
            <span class="text-ugh-teal font-bold uppercase tracking-widest text-xs font-display">Core Disciplines</span>
            <h2 class="text-4xl md:text-5xl font-display font-bold mt-2">What We Teach</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 bg-white border border-border-gray hover:border-ugh-teal transition-colors">
              <h3 class="text-2xl font-display font-bold mb-4">Skateboarding</h3>
              <p class="text-gray-600 leading-relaxed">Master the concrete waves. From static balance to ollies, flip tricks, and transition carving.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray hover:border-ugh-teal transition-colors">
              <h3 class="text-2xl font-display font-bold mb-4">Inline Skating</h3>
              <p class="text-gray-600 leading-relaxed">Speed, agility, and precision. Learn strides, crossovers, stopping mechanics, and freestyle slalom.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray hover:border-ugh-teal transition-colors">
              <h3 class="text-2xl font-display font-bold mb-4">BMX</h3>
              <p class="text-gray-600 leading-relaxed">Two-wheeled progression. From basic pump track rhythm to bunny hops and manual control.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Leadership -->
      <section id="leadership" class="py-24 px-6 bg-light-sand">
        <div class="max-w-4xl mx-auto text-center">
          <span class="text-ugh-orange font-bold uppercase tracking-widest text-xs font-display">Founded by Leela</span>
          <h2 class="text-4xl md:text-5xl font-display font-bold mt-2 mb-10">Leadership</h2>
          <div class="bg-white p-10 border-l-4 border-ugh-teal shadow-sm text-left">
            <p class="text-lg text-charcoal leading-relaxed font-medium mb-4">
              Tribhuvan Kokkula — Vice-Chairman, Skateboarding Sub-Committee, Roller Skating Federation of India (RSFI), 2026–2027 term. RSFI-certified National Referee and Technical Official.
            </p>
            <p class="text-sm text-gray-500">
              Urban Gliding Hyderabad is an MSME registered sports enterprise (UDYAM-TS-09-0222985).
            </p>
          </div>
        </div>
      </section>

      <!-- Community Impact -->
      <section id="community" class="py-24 px-6 border-b border-border-gray">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16">
            <span class="text-ugh-teal font-bold uppercase tracking-widest text-xs font-display">Where We've Coached</span>
            <h2 class="text-4xl md:text-5xl font-display font-bold mt-2 mb-6">Community Impact</h2>
            <p class="text-gray-600 max-w-2xl mx-auto text-lg">Delivering structured doorstep coaching across premium residential communities in Hyderabad.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">Aparna Serene Park</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Kondapur/Gachibowli</p>
              <p class="text-gray-600 text-sm leading-relaxed">Conducted introductory skateboarding and inline skating workshops in this expansive ~19-acre community. Our coaching sessions brought action sports directly to the ~1,680 units, providing convenient doorstep learning.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">Aparna Sarovar Zenith</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Nallagandla</p>
              <p class="text-gray-600 text-sm leading-relaxed">Ran dedicated coaching sessions across this ~24.6-acre residential space. We introduced safe, structured inline skating and skateboarding fundamentals to the community.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">Aparna Sarovar Grande</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Nallagandla</p>
              <p class="text-gray-600 text-sm leading-relaxed">Led active youth workshops in this ~10.5-acre property. Our focus on certified safety gear and progressive learning helped residents master the concrete safely.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">Aparna Hights I</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Kondapur</p>
              <p class="text-gray-600 text-sm leading-relaxed">Conducted action sports clinics for the residents, bringing our doorstep coaching model to life. Sessions focused on balance, agility, and fundamental skate mechanics.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">PBEL City</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Peerancheru</p>
              <p class="text-gray-600 text-sm leading-relaxed">Ran summer camp clinics and recurring coaching batches for residents. We transformed the community spaces into active learning zones for skateboarding and inline skating.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">Ananda Bay Hills</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Narsingi</p>
              <p class="text-gray-600 text-sm leading-relaxed">Provided structured doorstep coaching within this ~5.29-acre community. We introduced fundamental ramp transitions and flat-ground skills to the youth.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">My Home Tarkshya</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Kokapet</p>
              <p class="text-gray-600 text-sm leading-relaxed">Conducted safe, structured skating sessions for residents of this ~5.82-acre, 660-unit community. Our coaches focused on foundational skills and proper safety protocols.</p>
            </div>
            <div class="p-8 bg-white border border-border-gray">
              <h3 class="text-xl font-display font-bold mb-2">My Home Navadweepa</h3>
              <p class="text-xs text-ugh-orange font-bold uppercase tracking-widest mb-4">Madhapur/HITEC City</p>
              <p class="text-gray-600 text-sm leading-relaxed">Ran introductory and progression workshops for the community. We delivered professional action sports instruction directly to the residents' doorsteps.</p>
            </div>
          </div>
        </div>
